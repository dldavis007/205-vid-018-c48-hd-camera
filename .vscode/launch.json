{
    "version": "0.2.0",
    "configurations": [
        {
            // Steps through the firmware running on the PC. Set breakpoints in
            // Subroutines.c, MenuFunctions.c, mco.c... as usual. While you sit
            // on a breakpoint the RTI thread keeps running, but its catch-up is
            // capped, so resuming does not expire every firmware timer at once.
            // Needs the C/C++ extension (ms-vscode.cpptools).
            "name": "PC_SIDE: Debug host",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/Rev 1.01/pc_side/pc_side_host.exe",
            "args": [
                "20018",
                "20100"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/Rev 1.01/pc_side",
            "environment": [],
            "externalConsole": true,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/TDM-GCC-64/bin/gdb.exe",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "PC_SIDE: Build only"
        }
    ]
}
